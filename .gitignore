# =============================================================================
# Never commit
# =============================================================================
# Secrets. .env holds the encryption key and the database password.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
secrets/

# Operational data. Feed files, generated reports, catalogue snapshots and
# database dumps all contain the operator's commercial information -- supplier
# pricing, stock levels and the full product catalogue. None of it belongs in
# version control.
data/
!data/.gitkeep
*.sqlite
*.sqlite3
*.db
*.dump
*.sql.gz

# Vendor feed archives, wherever they land
*.zip
FULL_FEED_*
DELTA_FEED_*
All+Listings+Report*
*.xlsm

# Generated reports
*.xlsx
!docs/**/*.xlsx

# =============================================================================
# Python
# =============================================================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# Virtual environments
.venv/
venv/
env/
ENV/

# Testing and tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# =============================================================================
# Editors and operating systems
# =============================================================================
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini
